{
  "name": "sklejka",
  "productName": "Склейка",
  "version": "1.0.0",
  "description": "Бесплатный видеоредактор: таймлайн, текст, фильтры, переходы, автосубтитры, экспорт MP4",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . Sklejka --platform=win32 --arch=x64 --out=dist --overwrite --icon=icon.ico --ignore=^/dist"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.1"
  }
}
